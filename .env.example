# Umgebungsvariablen für das Hosting auf Vercel
# (Vercel → Projekt → Settings → Environment Variables). Diese Datei enthält nur Platzhalter –
# echte Schlüssel nie ins Repository schreiben.

# ── Öffentlich: landen beim Build im Browser-Code ──────────────────────────────────────────────
# Supabase → Project Settings → API (Project URL, Publishable key)
VITE_SUPABASE_URL=https://<projekt-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Stripe → Developers → API keys. pk_test_… = Test-Modus (Banner "Test-Modus" an der Kasse), pk_live_… = echte Zahlungen.
VITE_PAYMENTS_CLIENT_TOKEN=pk_test_...

# ── Geheim: nur auf dem Server ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<projekt-id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Supabase → Project Settings → API → Secret key (umgeht alle Zugriffsregeln – nur hier eintragen)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Stripe → Developers → API keys → Secret key (sk_test_… für Test, sk_live_… erst beim Go-Live)
STRIPE_SANDBOX_API_KEY=sk_test_...
STRIPE_LIVE_API_KEY=sk_live_...
# Stripe → Developers → Webhooks → Endpoint
#   https://<deine-domain>/api/public/payments/webhook?env=sandbox   (im Test-Modus)
#   https://<deine-domain>/api/public/payments/webhook?env=live      (im Live-Modus)
# Ereignisse: checkout.session.completed, checkout.session.async_payment_succeeded
PAYMENTS_SANDBOX_WEBHOOK_SECRET=whsec_...
PAYMENTS_LIVE_WEBHOOK_SECRET=whsec_...

# Resend → API Keys (Domain yamiin-jaiyanas.de muss in diesem Resend-Konto bestätigt sein)
RESEND_API_KEY=re_...

# Optional: weitere eigene Adressen für Rücksprung- und Login-Links, kommagetrennt.
# Die Adressen des Vercel-Projekts selbst (*.vercel.app dieses Projekts) gelten automatisch.
APP_ALLOWED_ORIGINS=
